  "scenario": [
    {
      "id": "st_1",
      "caption": "Session opens at startup from your saved sign-in",
      "edgeIds": [
        "e_auth"
      ],
      "dir": "forward",
      "token": "cookies"
    },
    {
      "id": "st_2",
      "caption": "Claude Code or Codex calls ask() over MCP",
      "edgeIds": [
        "e_claude",
        "e_codex"
      ],
      "dir": "forward",
      "token": "ask"
    },
    {
      "id": "st_3",
      "caption": "Notebook found by name, from cache",
      "edgeIds": [
        "e_cache"
      ],
      "dir": "forward",
      "token": "specs"
    },
    {
      "id": "st_4",
      "caption": "One HTTPS call on the warm session",
      "edgeIds": [
        "e_lib",
        "e_https"
      ],
      "dir": "forward",
      "token": "ask"
    },
    {
      "id": "st_5",
      "caption": "NotebookLM answers only from your sources",
      "edgeIds": [
        "e_src"
      ],
      "dir": "forward",
      "token": "search"
    },
    {
      "id": "st_6",
      "caption": "A cited answer comes back",
      "edgeIds": [
        "e_src",
        "e_https"
      ],
      "dir": "reverse",
      "token": "answer [1][2]"
    },
    {
      "id": "st_7",
      "caption": "Trimmed to the answer and its sources",
      "edgeIds": [
        "e_lib"
      ],
      "dir": "reverse",
      "token": "answer"
    },
    {
      "id": "st_8",
      "caption": "Your agent gets the answer, not your documents",
      "edgeIds": [
        "e_claude",
        "e_codex"
      ],
      "dir": "reverse",
      "token": "cited answer"
    },
    {
      "id": "st_9",
      "caption": "add_source uploads files straight from disk",
      "edgeIds": [
        "e_docs"
      ],
      "dir": "forward",
      "token": "PDF"
    }
  ],
  "flowMode": "scenario"
